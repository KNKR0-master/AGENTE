        "stability_selector": "[data-tt=\"VideoOverviewPage_VideoOverviewPage_FlexColumn\"]",
        "expected_metrics": [
          "views",
          "total_watch_time_seconds",
          "average_watch_time_seconds",
          "watched_full_rate",
          "followers_generated",
          "likes",
          "comments",
          "shares",
          "saves",
          "traffic_for_you",
          "traffic_search",
          "traffic_profile",
          "traffic_following",
          "traffic_other",
          "traffic_sound"
        ],
        "required_metrics": [
