{
  "version": "2026-08-17.pt-BR.5",
  "validated_at": "2026-08-17T08:40:00-03:00",
  "catalog": {
    "url": "https://www.tiktok.com/tiktokstudio/content",
    "row_selector": "[data-tt=\"components_PostTable_Absolute\"]",
    "ready_selector": "[data-tt=\"components_PostTable_Absolute\"]",
    "stability_selector": "[data-tt=\"components_PostTable_Container\"]",
    "readiness_timeout_seconds": 45,
    "empty_state_texts": [
      "Nenhuma publicação",
      "No posts yet"
    ],
    "discovery_fallbacks": [
      "NETWORK_RESPONSE",
      "a[href*=\"/video/\"]",
      "[data-video-id]",
      "[data-item-id]",
      "[data-content-id]",
      "[data-aweme-id]"
    ],
    "scroll_selector": "[data-tt=\"components_PostTable_Container\"]",
    "max_pages": 300,
    "page_wait_ms": 900,
    "fields": {
      "video_url": {
        "selector": "[data-tt=\"components_PostInfoCell_a\"]",
        "attribute": "href"
      },
      "caption": "[data-tt=\"components_PostInfoCell_a\"]",
      "duration_seconds": {
        "selector": "[data-tt=\"VideoCover_index_TUXText\"]",
        "type": "duration_seconds"
      },
      "published_at": {
        "selector": "[data-tt=\"components_PublishStageLabel_TUXText\"]",
        "type": "datetime",
        "locale": "pt-BR"
      },
      "thumbnail_url": {
        "selector": "[data-tt=\"VideoCover_index_Image\"]",
        "attribute": "src"
      },
      "status": "[data-tt=\"components_PrivacyCell_TUXButton\"]",
      "views": {
        "selector": "[data-tt=\"components_RowLayout_FlexRow_6\"] [data-tt=\"components_ItemRow_TUXText\"]",
        "type": "number",
        "locale": "pt-BR"
      },
      "likes": {
        "selector": "[data-tt=\"components_RowLayout_FlexRow_7\"] [data-tt=\"components_ItemRow_TUXText\"]",
        "type": "number",
        "locale": "pt-BR"
      },
      "comments": {
        "selector": "[data-tt=\"components_RowLayout_FlexRow_8\"] [data-tt=\"components_ItemRow_TUXText\"]",
        "type": "number",
        "locale": "pt-BR"
      }
    }
  },
  "detail": {
